---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const title = 'Threaded Sight Glass (SG-300) — NPT Sight Glass for Compact, High-Pressure Lines';
const description = 'SG-300 threaded sight glass: male NPT/BSP 1/4"–3", borosilicate DIN 7080 window, 316 SS / Hastelloy / carbon steel body, rated up to 100 bar (1450 psi). Compact observation for tanks and small-bore piping.';

const specs = [
  ['Model', 'SG-300'],
  ['Mounting', 'Male NPT or BSP thread, direct screw-in installation'],
  ['Thread size', '1/4"–3" (NPT / BSP)'],
  ['Glass window', 'Borosilicate to DIN 7080'],
  ['Body material', '316 stainless steel; Hastelloy or carbon steel options'],
  ['Max pressure', 'Up to 100 bar (1450 psi)'],
  ['Max temperature', 'Application-dependent — confirm glass, seal and body limits with the factory datasheet'],
  ['Sealing', 'Seal material selected per media and temperature'],
  ['Options', 'Illumination light port, custom threads, material upgrade, OEM marking'],
];

const variants = [
  {
    name: 'SG-300 Standard',
    tag: 'Compact & proven',
    desc: 'The standard configuration: a 316 SS body with male NPT or BSP thread and a DIN 7080 borosilicate window. Sized for tight spots where a flange or clamp will not fit — tanks, accumulators, compressor packages and small-bore piping.',
    points: ['Male NPT or BSP, direct install', 'Borosilicate window to DIN 7080', '316 SS body with seal matched to media'],
  },
  {
    name: 'SG-300-L Illuminated',
    tag: 'Dark vessels, clear view',
    desc: 'Adds an integrated light port so you can inspect level, sediment and condition inside unlit tanks and reservoirs. A practical upgrade for hydraulic reservoirs, lube oil systems and storage tanks where the window sits in shadow.',
    points: ['Integrated LED illumination port', 'Low-voltage operation', 'Fits all SG-300 body sizes'],
  },
  {
    name: 'SG-300-C Carbon Steel High-Pressure',
    tag: 'Utility & oil & gas duty',
    desc: 'A carbon steel body option for utility lines, hydraulic circuits and oil & gas packages where stainless is not required and cost matters. Paired with the appropriate seal, it holds the full 100 bar (1450 psi) rating.',
    points: ['Carbon steel body for utility duty', 'Full 100 bar (1450 psi) pressure rating', 'Cost-effective for OEM quantities'],
  },
];

const faqs = [
  { q: 'What is the difference between NPT and BSP threads?', a: 'NPT (National Pipe Thread) is the US tapered pipe thread standard, while BSP (British Standard Pipe) is used widely in Europe, Asia and Australia. They are not interchangeable — the thread angles and pitches differ. The SG-300 is available with either male NPT or BSP threads in 1/4"–3"; tell us your standard and we supply the matching configuration.' },
  { q: 'How much pressure can the SG-300 handle?', a: 'The SG-300 is rated up to 100 bar (1450 psi). The practical limit on your installation depends on the window size, body material and seal chosen — larger windows and softer seals reduce the safe working pressure. Confirm your media and operating pressure with the factory datasheet before specifying.' },
  { q: 'What glass is used, and can it take thermal shock?', a: 'The SG-300 uses borosilicate glass to DIN 7080, which offers good thermal shock resistance compared with soda-lime glass. It is still a glass component: avoid direct cold-water spray on a hot window, and inspect it during maintenance for chips, cracks or etching.' },
  { q: 'Is the SG-300 suitable for food or pharmaceutical lines?', a: 'The SG-300 is an industrial line sight glass built for compact, high-pressure duty — it is not a hygienic sanitary sight glass. For food, beverage, dairy and pharma piping that requires tri-clamp mounting and USP Class VI / FDA-compliant materials, use our SG-100 tri-clamp sight glasses instead.' },
  { q: 'Can you make custom thread sizes, materials or OEM versions?', a: 'Yes. We offer custom threads, Hastelloy or carbon steel bodies, special seals and OEM-branded units. Custom projects run through our OEM/ODM process — see our OEM/ODM service page for the workflow and lead times.' },
];

const related = [
  { name: 'Tri-Clamp Sight Glasses (SG-100)', href: '/products/tri-clamp-sight-glasses/', desc: 'Hygienic sanitary sight glass with zero dead-leg tri-clamp mounting.' },
  { name: 'Sight Flow Indicators (SG-200)', href: '/products/sight-flow-indicators/', desc: 'Flapper, rotor, drip tube and ball types for visible flow confirmation.' },
  { name: 'Flanged Sight Glasses (SG-400)', href: '/products/flanged-sight-glasses/', desc: 'Large-window ANSI/DIN flanged units for chemical and oil & gas piping.' },
];
---

<Layout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <nav class="flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-white">Home</a>
        <span>/</span>
        <a href="/products/" class="transition hover:text-white">Products</a>
        <span>/</span>
        <span class="text-slate-200">Threaded Sight Glasses</span>
      </nav>
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-green">THREADED SIGHT GLASS</p>
          <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Threaded Sight Glass (SG-300) — NPT Sight Glass for Compact, High-Pressure Lines</h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">When space is tight and pressure is high, the SIGHTSPEC SG-300 threaded sight glass is the compact answer. It screws directly into a tank, vessel or small-bore line with a male NPT or BSP thread, giving operators a durable borosilicate window rated up to 100 bar (1450 psi) — no flange, no clamp, no extra pipework.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <button type="button" data-quote-open class="rounded-lg bg-cta-orange px-6 py-3 text-center text-base font-semibold text-white shadow-lg transition hover:bg-orange-600">Request a Quote</button>
            <a href="#specifications" class="rounded-lg border border-white/20 px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-white/10">View Specifications</a>
          </div>
        </div>
        <!-- Image placeholder (asset pipeline later) -->
        <svg viewBox="0 0 600 500" class="w-full rounded-2xl ring-1 ring-white/10" role="img" aria-label="SG-300 threaded sight glass placeholder image">
          <rect width="600" height="500" fill="#102A45"/>
          <circle cx="300" cy="210" r="110" fill="none" stroke="#2563EB" stroke-width="3"/>
          <circle cx="300" cy="210" r="70" fill="none" stroke="#10B981" stroke-width="3"/>
          <circle cx="300" cy="210" r="16" fill="#F97316"/>
          <rect x="230" y="320" width="140" height="34" rx="4" fill="#17395C"/>
          <rect x="238" y="354" width="124" height="10" rx="3" fill="#17395C"/>
          <text x="300" y="420" text-anchor="middle" fill="#64748B" font-size="18" font-family="sans-serif">SG-300 THREADED SIGHT GLASS (PLACEHOLDER)</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">PRODUCT OVERVIEW</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Direct Screw-In Observation for Tanks and Small-Bore Piping</h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600">The SG-300 is the sight glass you reach for when a tri-clamp or flange simply will not fit. Its male thread installs directly into a tapped port on a tank, reservoir, accumulator or pipe — a clean, leak-resistant connection that takes minutes to fit and needs no gasket alignment. Inside, a DIN 7080 borosilicate window gives a clear view of level, color, foam, sediment and flow condition, while the compact body keeps the assembly short and unobtrusive. With 316 stainless as standard and Hastelloy or carbon steel as options, the SG-300 covers everything from hydraulic reservoirs to utility and oil & gas packages.</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> Compact direct screw-in NPT / BSP mounting</li>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> Rated up to 100 bar (1450 psi)</li>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> Borosilicate window to DIN 7080</li>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> 316 SS standard; Hastelloy / carbon steel options</li>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> Thread sizes 1/4"–3" (NPT / BSP)</li>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><span class="mt-0.5 text-brand-green">✓</span> Illumination, custom threads and OEM options</li>
      </ul>
    </div>
  </section>

  <!-- Specifications -->
  <section id="specifications" class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">SPECIFICATIONS</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">SG-300 Technical Specifications</h2>
      <p class="mt-4 max-w-3xl text-base text-slate-600">Standard ratings are based on published threaded sight glass practice. Confirm the final window, seal and body selection against your media, temperature and pressure before ordering.</p>
      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-5 py-4 font-semibold">Parameter</th>
              <th class="px-5 py-4 font-semibold">Specification</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {specs.map(([item, value]) => (
              <tr class="transition hover:bg-slate-50">
                <td class="px-5 py-4 font-bold text-navy-950">{item}</td>
                <td class="px-5 py-4 text-slate-600">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-500">* Ratings are application-dependent — glass is a consumable component and should be inspected during routine maintenance. Contact the factory for the current datasheet.</p>
    </div>
  </section>

  <!-- Variants -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">CONFIGURATIONS</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Three Configurations for Every Installation</h2>
      <p class="mt-4 max-w-3xl text-base text-slate-600">All SG-300 variants share the same threaded body platform and DIN 7080 window. Choose the material and accessories that match your pressure, media and viewing conditions.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {variants.map((v) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="inline-block rounded-full bg-brand-green/10 px-3 py-1 text-xs font-semibold text-brand-green">{v.tag}</span>
            <h3 class="mt-4 text-lg font-bold text-navy-950">{v.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.desc}</p>
            <ul class="mt-4 space-y-2">
              {v.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-slate-700"><span class="mt-0.5 text-brand-blue">•</span>{p}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Applications -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-green">APPLICATIONS</p>
      <h2 class="mt-2 text-2xl font-extrabold sm:text-3xl">Where the SG-300 Earns Its Threads</h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-300">The SG-300 is specified wherever a small, strong observation point is needed and space is at a premium. Typical installations include storage and process tanks, hydraulic and lube oil reservoirs, compressor packages, accumulators, dosing skids and small-bore utility piping. Because the window sits flush in a threaded boss, it is easy to fit, easy to swap and adds no significant pressure drop to the line.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-navy-900 p-6">
          <h3 class="text-lg font-bold text-white">Oil & Gas Packages</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Instrument air, fuel and utility lines on compressor and process packages — see our <a href="/applications/oil-gas/" class="text-brand-blue underline transition hover:text-white">oil & gas applications</a> for more on how sight glasses fit these skids.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-navy-900 p-6">
          <h3 class="text-lg font-bold text-white">Chemical & Utility Duty</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Tanks and small lines in chemical and utility plants where the carbon steel or 316 SS body matches existing piping — see <a href="/applications/chemical-processing/" class="text-brand-blue underline transition hover:text-white">chemical processing applications</a>.</p>
        </div>
      </div>
      <p class="mt-6 text-sm text-slate-400">For hygienic food, beverage and pharmaceutical lines, use the <a href="/products/tri-clamp-sight-glasses/" class="text-brand-blue underline transition hover:text-white">SG-100 tri-clamp sight glass</a> instead. Not sure? <a href="/contact/" class="text-brand-blue underline transition hover:text-white">Send us your drawing</a> and we will recommend the right model.</p>
    </div>
  </section>

  <!-- Related products -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">RELATED PRODUCTS</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Other Sight Glass Options</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {related.map((r) => (
          <a href={r.href} class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-base font-bold text-navy-950 group-hover:text-brand-blue">{r.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.desc}</p>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm text-slate-500">Browse the full range on our <a href="/products/" class="text-brand-blue underline hover:text-navy-950">products overview</a>, or read our <a href="/faq/" class="text-brand-blue underline hover:text-navy-950">general FAQ</a> for ordering, lead time and documentation questions.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">FAQ</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Threaded Sight Glass FAQ</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-bold text-navy-950">
              {f.q}
              <span class="text-brand-blue transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Need a Compact Sight Glass Rated to 100 Bar?" subtitle="Send your thread type, size, media and pressure — get the right SG-300 configuration and a factory-direct quote within 24 hours." />
</Layout>
