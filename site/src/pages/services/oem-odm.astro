---
// SIGHTSPEC OEM/ODM — Custom Sight Glass Manufacturing
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const title = 'OEM / ODM Sight Glass Manufacturing — Custom Windows to Your Spec';
const description = 'SIGHTSPEC OEM/ODM sight glass customization: custom sizes 1/4" to 12", DIN 7080 borosilicate, custom flange drilling, hygienic finishes, private label. MOQ 10 pieces, production lead time 15-30 days.';

const offers = [
  { title: 'Custom Sizes & Connections', desc: 'From 1/4" threaded to 12" tri-clamp, ANSI flanged, weld-in, bolt-on and hinged. We cut, fuse and edge-finish glass to your exact envelope — not just standard catalog sizes.' },
  { title: 'Custom Glass Selection', desc: 'Soda-lime below 300°F, borosilicate (DIN 7080) up to 572°F, quartz or sapphire above 572°F. Mica shields for extreme abrasive service.' },
  { title: 'Custom Materials & Finishes', desc: '304 or 316L stainless steel, Hastelloy, duplex and carbon steel bodies. Hygienic surface finishes to Ra ≤ 0.4 µm with electropolishing for pharma and food lines.' },
  { title: 'Custom Gaskets & Seals', desc: 'EPDM, FKM (Viton), PTFE, silicone and hygienic TPE gaskets matched to your media and temperature — critical for chemical compatibility.' },
  { title: 'Custom Pressure & Vacuum Ratings', desc: 'Windows pressure-rated to 100 bar (threaded) and vacuum-rated to 230 psi FV (tri-clamp). We size glass thickness and support ring for your duty.' },
  { title: 'Private Label & Branding', desc: 'Your logo laser-engraved on the body, printed on packaging and datasheets. Your brand, our engineering and production capacity.' },
];

const tableRows = [
  { parameter: 'Size range', options: '1/4" to 12" (DN8–DN300)', notes: 'Custom intermediate sizes available' },
  { parameter: 'Glass', options: 'Soda-lime / Borosilicate DIN 7080 / Quartz / Sapphire', notes: 'Selected by temperature & media' },
  { parameter: 'Body material', options: '304 SS, 316L SS, Hastelloy, duplex, carbon steel', notes: 'Hygienic finish Ra ≤ 0.4 µm' },
  { parameter: 'Connection', options: 'Tri-clamp, NPT/BSP, ANSI flange, weld-in, bolt-on, hinged', notes: 'Custom flange drilling' },
  { parameter: 'Pressure rating', options: 'Up to 100 bar (threaded); FV to 230 psi (tri-clamp)', notes: 'Glass thickness per duty' },
  { parameter: 'Temperature', options: 'Up to 572°F borosilicate; 1000°F+ quartz', notes: 'Mica shield option' },
  { parameter: 'Gaskets', options: 'EPDM, FKM, PTFE, silicone, hygienic TPE', notes: 'Media-compatible selection' },
  { parameter: 'MOQ', options: '10 pcs (production), samples available', notes: 'Lead time 15-30 days' },
];

const process = [
  { title: 'Spec Review', desc: 'We confirm size, glass, body, connection and any certification needs — often within 24 h.' },
  { title: 'Drawing & Sample', desc: 'DWG/PDF drawing for approval, then a pre-production sample for fit, finish and glass clarity.' },
  { title: 'Production', desc: 'Batch production with in-process glass inspection and 100% pressure testing.' },
  { title: 'Shipment & Docs', desc: 'Material certificates, pressure test reports and compliance docs (DIN 7080 / USP Class VI) packed with the order.' },
];
---

<Layout title={`${title} | SIGHTSPEC`} description={description}>
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h1 class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">From a single custom window to high-volume private-label programs — we build sight glasses the way your process needs them.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {offers.map((o) => (
          <div class="rounded-2xl border border-slate-200 p-8">
            <h2 class="text-lg font-bold text-navy-950">{o.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">OEM / ODM Capability Table</h2>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-6 py-4 font-semibold">Parameter</th>
              <th class="px-6 py-4 font-semibold">Options</th>
              <th class="px-6 py-4 font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tableRows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-navy-950">{r.parameter}</td>
                <td class="px-6 py-4 text-slate-700">{r.options}</td>
                <td class="px-6 py-4 text-slate-500">{r.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">How OEM / ODM Works</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-4">
        {process.map((s, i) => (
          <div>
            <span class="text-5xl font-extrabold text-navy-950/10">0{i + 1}</span>
            <h3 class="mt-2 font-bold text-navy-950">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Have a Drawing or Sample to Quote?"
    subtitle="Send your sight glass drawing or sample spec — we respond within 24 hours with unit pricing, MOQ and lead time."
  />
</Layout>
